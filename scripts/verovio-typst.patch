+namespace {
+
+// Checks if 2+ note letters (A-G or -) appear before the next ')' in the string.
+bool hasTupletPattern(const char *s)
+{
+    int noteCount = 0;
+    for (const char *p = s; *p; ++p) {
+        if (*p == ')') return noteCount >= 2;
+        if ((*p >= 'A' && *p <= 'G') || *p == '-') noteCount++;
+    }
+    return false;
+}
+
+// Scans for target char before the next note letter (A-G).
+bool hasCharBeforeNote(const char *s, char target)
+{
+    for (const char *p = s; *p; ++p) {
+        if (*p >= 'A' && *p <= 'G') return false;
+        if (*p == target) return true;
+    }
+    return false;
+}
+
+// Replaces all occurrences of `from` with `to` in string s.
+void replaceAll(std::string &s, const std::string &from, const std::string &to)
+{
+    size_t pos = 0;
+    while ((pos = s.find(from, pos)) != std::string::npos) {
+        s.replace(pos, from.length(), to);
+        pos += to.length();
+    }
+}
+
+// Checks if the entire string is digits (non-empty).
+bool isAllDigits(const char *s)
+{
+    if (!*s) return false;
+    for (const char *p = s; *p; ++p) {
+        if (!isdigit(static_cast<unsigned char>(*p))) return false;
+    }
+    return true;
+}
+
+// Parses mensural time signature: ([co])([./]?)([./]?)(\d*)/?(\d*)
+// Returns true if the string matches this pattern exactly.
+bool parseMensural(const char *s, char &sign, char &mod1, char &mod2, std::string &num, std::string &numbase)
+{
+    sign = '\0';
+    mod1 = '\0';
+    mod2 = '\0';
+    num.clear();
+    numbase.clear();
+
+    if (*s != 'c' && *s != 'o') return false;
+    sign = *s++;
+    if (*s == '.' || *s == '/') mod1 = *s++;
+    if (*s == '.' || *s == '/') mod2 = *s++;
+    while (isdigit(static_cast<unsigned char>(*s))) num += *s++;
+    if (*s == '/') {
+        s++;
+        while (isdigit(static_cast<unsigned char>(*s))) numbase += *s++;
+    }
+    return *s == '\0';
+}
